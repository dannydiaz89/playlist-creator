# Convex — `pnpm dev:convex` writes NEXT_PUBLIC_CONVEX_URL for you.
# Add the SITE url yourself: same host, .convex.cloud -> .convex.site
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Better Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# NOT localhost — Spotify rejects it as a redirect URI.
BETTER_AUTH_URL=http://127.0.0.1:3000
# Same value, readable by the browser (used in sign-in error messages).
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# Spotify app (developer.spotify.com). Add your own account to the app's
# allowlist: a new app is in Development Mode, max 25 manually-added users.
# Also set these on Convex (`npx convex env set`) — Better Auth runs there.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Market used for student catalog search.
SPOTIFY_MARKET=US

# Google Cloud project with the YouTube Data API v3 enabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Gates sign-up. Without this set, NOBODY can sign up (fails closed).
# Generate one, run `pnpm seed`, then rotate or remove it.
TEACHER_INVITE_CODE=

# Used by `pnpm seed`.
SEED_TEACHER_EMAIL=
SEED_TEACHER_PASSWORD=
# Optional display name for the seeded account.
# SEED_TEACHER_NAME=Teacher
